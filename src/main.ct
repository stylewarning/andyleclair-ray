(cl:defpackage #:ray
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames
    (#:file #:coalton/file)
    (#:it #:coalton/iterator)
    (#:sh #:coalton/show)))

(cl:in-package #:ray)

(coalton-toplevel
  (define-struct Color
    (r Integer)
    (g Integer)
    (b Integer))
  
  (define *red* (Color 255 0 0))
  (define *green* (Color 0 255 0))
  (define *blue* (Color 0 0 255))
  
  (define *width* 256)
  (define *height* 256)
  (define *colors* 255)
  
  (declare generate-pixels (Integer * Integer -> (List Color)))
  (define (generate-pixels width height)
    [(Color x y 0) :for x :below width :for y :below height])

  (declare write-header (file:FileStream Char -> Void)) 
  (define (write-header stream)
    (lisp (-> Void) (stream)
      (cl:format stream "P3~%~D ~D~%~D~%" *width* *height* *colors*)
      (cl:values)))
  
  (declare write-pixel (file:FileStream Char * Color -> Void))
  (define (write-pixel stream pixel)
    (let ((r (.r pixel))
          (g (.g pixel))
          (b (.b pixel)))
      (lisp (-> Void) (stream r g b) 
        (cl:format stream "~D ~D ~D~%" r g b)
        (cl:values))))
  
  (declare write-pixels (file:FileStream Char * (List Color) -> Void))
  (define (write-pixels stream pixels)
    (it:for-each! (fn (px) (write-pixel stream px)) (it:into-iter pixels)))
  
  (declare save-image (Void -> (Result file:FileError UFix)))
  (define (save-image)
    (let all-pixels = (generate-pixels *width* *height*))
    (file:with-open-file "out.ppm"
      (fn (stream)
        (write-header stream)
        (write-pixels stream all-pixels)
        (Ok 0))
      :direction file::Output
      :if-exists file::Overwrite))

  (declare main (Void -> Void))
  (define (main)
    (match (save-image)
      ((Ok _) (show "Wrote file!"))
      ((Err errored)
        (match errored
          ((file:FileError str) (show "File error: ") (show str))
          (_None (show "Unknown error occurred")))))))
