(cl:defpackage #:ray
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames (#:file #:coalton/file)))

(cl:in-package #:ray)

(coalton-toplevel
  (define-struct Color
    (r Integer)
    (g Integer)
    (b Integer))
  
  (define *red* (Color 255 0 0))
  (define *green* (Color 0 255 0))
  (define *blue* (Color 0 0 255))
  
  (define *width* 256)
  (define *height* 256)
  (define *colors* 255)
  
  (declare generate-pixels (Integer * Integer -> (List Color)))
  (define (generate-pixels width height)
    [(Color x y 0) :for x :below width :for y :below height])

  (declare ppm-header (Void -> String)) 
  (define (ppm-header)
          (lisp (-> String) () 
            (cl:format cl:nil "P3~%~D ~D~%~D~%" *width* *height* *colors*)))
  
  (declare pixel->string (Color -> String))
  (define (pixel->string pixel)
    (let ((r (.r pixel))
          (g (.g pixel))
          (b (.b pixel)))
      (lisp (-> String) (r g b) 
        (cl:format cl:nil "~D ~D ~D~%" r g b))))
  
  (declare pixels->string ((List Color) -> String))
  (define (pixels->string pixels)
    (fold (fn (acc px) (<> acc (pixel->string px))) "" pixels))
  
  (declare save-image (Void -> Result file:FileError Unit))
  (define (save-image)
    (let* ((header (ppm-header))
           (all-pixels (generate-pixels *width* *height*))
           (body (pixels->string all-pixels)))
      (file:with-open-file "out.ppm"
        (fn (stream)
          (file:write-string stream header)
          (file:write-string stream body))
        :direction file::Output
        :if-exists file::Overwrite)))

  (declare main (Void -> Void))
  (define (main)
    (match (save-image)
      ((Ok _) (lisp (-> Void) () (cl:format cl:t "Wrote file!") (cl:values)))
      ((Err errored) (lisp (-> Void) (errored) (cl:format cl:t "Got error!! ~A" (cl:the (String) errored)) (cl:values))))))
