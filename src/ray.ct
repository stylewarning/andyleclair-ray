(cl:defpackage #:ray/ray
  (:use #:coalton #:coalton-prelude)
  (:local-nicknames (#:vec #:ray/vec3))
  (:export #:Ray
           #:ray-at))

(cl:in-package #:ray/ray)

(coalton-toplevel
  (define-struct Ray
    (:origin vec:Vec3)
    (:direction vec:Vec3))
  
  (declare ray-at (Ray * F64 -> vec:Vec3))
  (define (ray-at ray t)
    (vec:vec-add (.origin ray)
             (vec:vec-mul-scalar (.direction ray) t)))
)
