(cl:defpackage #:ray/color
  (:use #:coalton #:coalton-prelude)
  (:export #:Color
           #:mul
           #:add))

(cl:in-package #:ray/color)

(coalton-toplevel
  (define-struct Color
    (r F32)
    (g F32)
    (b F32))
  
  (declare mul (Color * F32  -> Color))
  (define (mul (Color r g b) v)
    (Color (* r v) (* g v) (* b v)))
  
  (declare add (Color * Color  -> Color))
  (define (add (Color r1 g1 b1) (Color r2 g2 b2))
    (Color (+ r1 r2) (+ g1 g2) (+ b1 b2))))